# ==============================================================================
# ENVIRONMENT CONFIGURATION - E-COMMERCE SENTRA KULINER SULAWESI UTARA
# ==============================================================================

# Database Connection (SQLite untuk local zero-setup / PostgreSQL pada deployment)
DATABASE_URL="file:./dev.db"

# Authentication secrets (generate unique values; never commit real values)
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-separate-random-token-of-at-least-32-characters"
ADMIN_INITIAL_PASSWORD="set-a-unique-admin-password-of-at-least-12-characters"
DEMO_CUSTOMER_PASSWORD="set-a-demo-customer-password-of-at-least-8-characters"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Midtrans Payment Gateway (Sandbox Environment)
# Dapatkan Server Key & Client Key dari https://dashboard.sandbox.midtrans.com/
MIDTRANS_SERVER_KEY="SB-Mid-server-DEMO_TEST_KEY_SULUT_2026"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-DEMO_TEST_KEY_SULUT_2026"
MIDTRANS_IS_PRODUCTION="false"

# RajaOngkir Ekspedisi API (JNE, POS, TIKI)
# ID Kota 266 = Kota Manado (Origin Gudang Sentra UMKM)
RAJAONGKIR_API_KEY="rajaongkir_demo_key_sulut_market"
RAJAONGKIR_ORIGIN_CITY_ID="266"

# Cloudflare DNS, SSL & Security Headers
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
