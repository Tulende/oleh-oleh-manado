{
  "name": "sentra-kuliner-sulut",
  "version": "1.0.0",
  "description": "Marketplace Sentra Oleh-Oleh & UMKM Kuliner khas Sulawesi Utara dengan Midtrans, Inventory Locking & CRM",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "d1:create": "npx --offline=false wrangler d1 create oleh-oleh-db",
    "d1:migrate:local": "npx --offline=false wrangler d1 execute oleh-oleh-db --local --file=./prisma/d1_schema.sql",
    "d1:migrate:prod": "npx --offline=false wrangler d1 execute oleh-oleh-db --remote --file=./prisma/d1_schema.sql",
    "cf:build": "npx --offline=false --yes --package=@opennextjs/cloudflare@1.10.0 --package=wrangler@4.38.0 opennextjs-cloudflare build",
    "cf:preview": "npx --offline=false --yes --package=@opennextjs/cloudflare@1.10.0 --package=wrangler@4.38.0 opennextjs-cloudflare build && npx --offline=false --yes --package=@opennextjs/cloudflare@1.10.0 --package=wrangler@4.38.0 opennextjs-cloudflare preview",
    "cf:deploy": "npx --offline=false --yes --package=@opennextjs/cloudflare@1.10.0 --package=wrangler@4.38.0 opennextjs-cloudflare deploy",
    "deploy": "npm run cf:build && npm run cf:deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@opennextjs/cloudflare": "1.10.0",
    "@prisma/client": "5.22.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "4.38.0"
  }
}
